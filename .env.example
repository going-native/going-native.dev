# Manifesto signing backend. See /manifesto.
# Site's own atproto account used to host the signer index record.
MANIFESTO_SITE_HANDLE=going-native.dev
MANIFESTO_SITE_APP_PASSWORD=
# PDS of the site account. Omit to default to https://bsky.social
MANIFESTO_SITE_PDS=https://bsky.social
# Ed25519 private key (base64 of PKCS#8 PEM). Generate with:
#   node scripts/generate-manifesto-key.mjs
MANIFESTO_SIGNING_KEY=
