---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<svg class="logo" viewBox="0 0 24 24" fill="none" stroke="#CE412B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="24" height="24">
					<rect x="4" y="4" width="16" height="16" rx="2"/>
					<rect x="8" y="8" width="8" height="8" rx="1"/>
					<path d="M12 20v2"/><path d="M12 2v2"/><path d="M17 20v2"/><path d="M17 2v2"/>
					<path d="M2 12h2"/><path d="M2 17h2"/><path d="M2 7h2"/>
					<path d="M20 12h2"/><path d="M20 17h2"/><path d="M20 7h2"/>
					<path d="M7 20v2"/><path d="M7 2v2"/>
				</svg>
				{SITE_TITLE}
			</a>
		</h2>
		<a href="https://github.com/going-native" target="_blank" rel="noopener noreferrer">
			<span class="sr-only">Going Native on GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #1a1b20;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 50%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-left: -0.25em;
	}
	.logo {
		flex-shrink: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
